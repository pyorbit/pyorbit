{
  "name": "pyorbit",
  "private": true,
  "workspaces": ["apps/web", "packages/ui", "packages/types", "packages/config"],
  "scripts": {
    "dev": "npm run dev -w @pyorbit/web",
    "build": "npm run build -w @pyorbit/web",
    "lint": "npm run lint -w @pyorbit/web",
    "typecheck": "npm run typecheck -w @pyorbit/web",
    "test": "npm run test -w @pyorbit/web",
    "format:web": "npm run format -w @pyorbit/web",
    "format:check": "npm run format:check -w @pyorbit/web",
    "content:validate": "npm run content:validate -w @pyorbit/web",
    "check": "npm run content:validate && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  }
}
